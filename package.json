{
  "name": "eagler-touhou-workspace",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "npm --prefix launcher run dev",
    "start": "npm --prefix launcher start",
    "build": "npm --prefix launcher run build",
    "typecheck": "npm --prefix launcher run typecheck",
    "test": "npm --prefix launcher test",
    "build:runtime": "node launcher/scripts/build-runtime.mjs",
    "workspace": "node tools/workspace.mjs",
    "docs:check": "node tools/docs/check.mjs",
    "docs:index": "node tools/docs/check.mjs --write-index",
    "adaptation:new": "node tools/docs/new-adaptation.mjs",
    "ports:check": "node tools/ports/check.mjs",
    "ports:status": "node tools/ports/check.mjs --write-status"
  }
}
