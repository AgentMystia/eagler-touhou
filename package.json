{
  "name": "eagler-touhou-project",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": "^24.15.0 || >=26"
  },
  "workspaces": [
    "contracts",
    "launcher/web",
    "services/netplay"
  ],
  "scripts": {
    "start": "npm run start --workspace @eagler/web",
    "dev": "npm run dev --workspace @eagler/web",
    "build": "npm run build --workspace @eagler/web",
    "check": "node tools/project.mjs check",
    "check:workspace": "node tools/project.mjs check --games",
    "doctor": "node tools/project.mjs doctor",
    "runtime": "node tools/project.mjs runtime",
    "dependencies": "node tools/project.mjs dependencies",
    "host": "npm run host --workspace @eagler/web --",
    "release": "npm run release --workspace @eagler/web --",
    "format": "prettier --write launcher/web/app launcher/web/src contracts/src",
    "format:check": "prettier --check launcher/web/app launcher/web/src contracts/src",
    "test:services": "npm run test --workspace @eagler/netplay",
    "relay": "npm run start --workspace @eagler/netplay",
    "package:self-host": "npm run package:self-host --workspace @eagler/web --",
    "package:release-assets": "npm run package:release-assets --workspace @eagler/web --"
  },
  "devDependencies": {
    "prettier": "3.9.10"
  },
  "overrides": {
    "tldts-icann": {
      "tldts-core": "7.4.11"
    }
  }
}
