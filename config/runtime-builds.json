{
  "schema": "eagler-touhou/runtime-builds/1",
  "defaults": {
    "cache": {
      "CMAKE_BUILD_TYPE": "Release",
      "TH_WEB_MUSIC": "BASE",
      "TH_WEB_SHARED_FONT": true
    }
  },
  "games": {
    "th06": {
      "builder": "cmake",
      "workspaceRepository": "th06",
      "assetRootVariable": "TH06_ASSET_ROOT",
      "variants": {
        "development": {
          "features": {
            "thcrap": true,
            "thprac": false
          },
          "cache": {
            "TH_EXTERNAL_ASSETS": false
          }
        },
        "external": {
          "features": {
            "thcrap": true,
            "thprac": false
          },
          "cache": {
            "TH_EXTERNAL_ASSETS": true
          }
        },
        "normal": {
          "features": {
            "thcrap": "configurable",
            "thprac": "configurable"
          },
          "cache": {
            "TH_ENABLE_NETPLAY": false,
            "TH_ENABLE_MULTIPLAYER_GAMEPLAY": false,
            "TH_EXTERNAL_ASSETS": false
          }
        },
        "multiplayer": {
          "features": {
            "thcrap": "configurable",
            "thprac": false
          },
          "cache": {
            "TH_ENABLE_NETPLAY": true,
            "TH_ENABLE_MULTIPLAYER_GAMEPLAY": true,
            "TH_EXTERNAL_ASSETS": false
          }
        }
      },
      "sourceBuild": {
        "kind": "cmake"
      }
    },
    "th07": {
      "builder": "cmake",
      "workspaceRepository": "th07",
      "assetRootVariable": "TH07_ASSET_ROOT",
      "variants": {
        "development": {
          "features": {
            "thcrap": true,
            "thprac": false
          },
          "cache": {
            "TH_EXTERNAL_ASSETS": false
          }
        },
        "external": {
          "features": {
            "thcrap": true,
            "thprac": false
          },
          "cache": {
            "TH_EXTERNAL_ASSETS": true
          }
        },
        "normal": {
          "features": {
            "thcrap": "configurable",
            "thprac": "configurable"
          },
          "cache": {
            "TH_ENABLE_NETPLAY": false,
            "TH_ENABLE_MULTIPLAYER_GAMEPLAY": false,
            "TH_EXTERNAL_ASSETS": false
          }
        },
        "multiplayer": {
          "features": {
            "thcrap": "configurable",
            "thprac": false
          },
          "cache": {
            "TH_ENABLE_NETPLAY": true,
            "TH_ENABLE_MULTIPLAYER_GAMEPLAY": true,
            "TH_EXTERNAL_ASSETS": false
          }
        }
      },
      "sourceBuild": {
        "kind": "cmake"
      }
    },
    "th10": {
      "builder": "prebuilt",
      "workspaceRepository": "th10",
      "variants": {
        "normal": {
          "features": {
            "thcrap": true,
            "thprac": true
          },
          "cache": {}
        },
        "multiplayer": {
          "features": {
            "thcrap": true,
            "thprac": false
          },
          "cache": {}
        }
      },
      "sourceBuild": {
        "kind": "node",
        "build": [
          "portable/build.mjs"
        ],
        "package": [
          "portable/package-eagler.mjs"
        ],
        "separateMultiplayerSource": true,
        "practiceFlag": "--thprac"
      }
    },
    "th09": {
      "builder": "prebuilt",
      "workspaceRepository": "th09",
      "variants": {
        "normal": {
          "features": {
            "thcrap": true,
            "thprac": false
          },
          "cache": {}
        },
        "multiplayer": {
          "features": {
            "thcrap": true,
            "thprac": false
          },
          "cache": {}
        }
      },
      "sourceBuild": {
        "kind": "node",
        "build": [
          "th09_web/scripts/build-sdl.mjs",
          "--release"
        ],
        "package": [
          "th09_web/scripts/build-eagler.mjs"
        ]
      }
    },
    "th08": {
      "builder": "prebuilt",
      "workspaceRepository": "th08",
      "variants": {
        "normal": {
          "features": {
            "thcrap": true,
            "thprac": true
          },
          "cache": {}
        },
        "multiplayer": {
          "features": {
            "thcrap": true,
            "thprac": true
          },
          "cache": {}
        }
      },
      "sourceBuild": {
        "kind": "node",
        "build": [
          "portable/build.mjs",
          "--th08"
        ],
        "package": [
          "portable/package-eagler.mjs"
        ],
        "separateMultiplayerSource": true
      }
    },
    "th11": {
      "builder": "prebuilt",
      "workspaceRepository": "th11",
      "variants": {
        "normal": {
          "features": {
            "thcrap": true,
            "thprac": true
          },
          "cache": {}
        },
        "multiplayer": {
          "features": {
            "thcrap": true,
            "thprac": false
          },
          "cache": {}
        }
      },
      "sourceBuild": {
        "kind": "node",
        "build": [
          "portable/build.mjs"
        ],
        "package": [
          "portable/package-eagler.mjs"
        ],
        "separateMultiplayerSource": true,
        "practiceFlag": "--thprac"
      }
    },
    "th15": {
      "builder": "prebuilt",
      "workspaceRepository": "th15",
      "variants": {
        "normal": {
          "features": {
            "thcrap": true,
            "thprac": true
          },
          "cache": {}
        }
      },
      "sourceBuild": {
        "kind": "node",
        "build": [
          "th15_web/scripts/build-sdl-application.mjs",
          "--release"
        ],
        "package": [
          "portable/package-eagler.mjs"
        ],
        "practiceFlag": "--thprac"
      }
    },
    "th20": {
      "builder": "prebuilt",
      "workspaceRepository": "th20",
      "variants": {
        "normal": {
          "features": {
            "thcrap": false,
            "thprac": false
          },
          "cache": {}
        }
      }
    }
  }
}
