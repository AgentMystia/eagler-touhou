# Eagler Touhou netplay relay. Copy to /etc/eagler-touhou/relay.env.
EAGLER_NETPLAY_RELAY_HOST=127.0.0.1
EAGLER_NETPLAY_RELAY_PORT=18142
EAGLER_NETPLAY_STUN_URLS=stun:stun.cloudflare.com:3478

# Optional TURN. Use the same shared secret in turn.env and relay.env.
# EAGLER_NETPLAY_TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
# EAGLER_NETPLAY_TURN_SHARED_SECRET=CHANGE_ME_SAME_AS_COTURN
# EAGLER_NETPLAY_TURN_TTL_SECONDS=3600

# Legacy TH07_* names are accepted only as compatibility aliases for existing
# deployments. New deployments should use EAGLER_NETPLAY_* exclusively.
